**** begin user architecture code


.param VDD=1.5
.csparam VDD=VDD
.param temp=27
.options savecurrents klu reltol=1e-3 abstol=1e-12 gmin=1e-9 trtol=25 itl1=200 itl4=50 rshunt=1e9
.control

shell rm -f output_buffer_tb_zout.raw
shell rm -f ../plot_simulations/data/output_buffer_tb_zout.txt

save all
set wr_vecnames
set wr_singlescale

op
write output_buffer_tb_zout.raw
set appendwrite
ac lin 200 200e6 600e6
write output_buffer_tb_zout.raw
let Rs = 50
let zout = -v(vout)
let zout_mag = mag(zout)
let zout_ph = 180/PI*cphase(zout)
let zout_re = real(zout)
let zout_im = imag(zout)
let Gam = (zout - Rs)/(zout + Rs)
let Gmag = mag(Gam)
let S11_dB = db(Gmag)
let ML_dB = -10*log10(1 - Gmag*Gmag)
plot real(zout) imag(zout) xlimit 200e6 600e6
wrdata ../plot_simulations/data/output_buffer_tb_zout.txt mag(zout) phase(zout) real(zout) imag(zout)

meas ac zmag_433 find zout_mag when frequency=433.92e6
meas ac zph_433 find zout_ph when frequency=433.92e6
meas ac zre_433 find zout_re when frequency=433.92e6
meas ac zim_433 find zout_im when frequency=433.92e6
meas ac S11_433 find S11_dB when frequency=433.92e6
meas ac ML_433 find ML_dB when frequency=433.92e6

unset appendwrite

echo
echo   Zout magnitude = $&zmag_433 ohm
echo   Zout real      = $&zre_433 ohm
echo   Zout imag      = $&zim_433 ohm
echo   Zout phase     = $&zph_433 deg
echo
echo   S11            = $&S11_433 dB
echo   mismatch loss  = $&ML_433 dB
echo

*quit
.endc



