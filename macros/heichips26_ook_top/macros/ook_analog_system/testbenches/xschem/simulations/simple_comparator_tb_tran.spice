**.subckt simple_comparator_tb_tran
VDDSRC VDD GND {VDD}
VIN vin GND PWL(0 {VIN_LOW} {T1} {VIN_LOW} {T2} {VIN_HIGH} {T3} {VIN_HIGH} {T4} {VIN_HOVER} {T5} {VIN_HOVER})
VREF vref GND {VREF_LEVEL}
VDDSRC1 VDDL GND {VDD/2}
x2 VDDL GND VDD vref vin comp_out simple_comparator
**** begin user architecture code


.param VDD=3.3
.param VREF_LEVEL=0.86
.param VIN_LOW=0
.param VIN_HIGH=0.92
.param VIN_HOVER=0.92
.param T1=1u
.param T2=2u
.param T3=4u
.param T4=5u
.param T5=10u
.options savecurrents klu reltol=1e-3 abstol=1e-12 vntol=1e-6 gmin=1e-9
.control
save v(vin) v(vref) v(comp_out) v(VDD) v(VSS) i(VDDSRC) i(VDDSRC1)
tran 1n 10u
write simple_comparator_tb_tran\.raw
meas tran t_cross_high TRIG v(vin) VAL={VREF_LEVEL} RISE=1 TARG v(comp_out) VAL={VDD/2} CROSS=1
meas tran t_hover_settle TRIG v(vin) VAL={VIN_HOVER} FALL=1 TARG v(comp_out) VAL={VDD/2} CROSS=1
print t_cross_high
print t_hover_settle
plot vin vref comp_out
plot i(VDDSRC)
plot i(VDDSRC1)
.endc


