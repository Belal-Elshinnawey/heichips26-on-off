**.subckt charge_pump_tb_tran vout
*.iopin vout
VCLKREF CLK_REF GND PULSE(0 {VDD} 0 0.5n 0.5n {0.5/FREQ_REF} {1/FREQ_REF})
VDDSRC VDD GND {VDD}
x4 CLK_FB VDD VDD net1 vout GND GND output_buffer_pex
x1 net1 VDD GND vcl vco_pex
VDDSRC1 VDD2 GND {2}
x7 VDD GND net2 VDD CLK_REF CLK_FB dac
R1 vcl net2 250k
C1 vcl GND 12p
