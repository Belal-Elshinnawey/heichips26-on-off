** sch_path: /home/belal/HeiChips/heichips26-on-off/macros/heichips26_ook/macros/ook_analog_system/testbenches/xschem/ook_receiver_tb_tran.sch
**.subckt ook_receiver_tb_tran
VDD3_3 VDD3_3 GND {VDD3_3}
VDD1_5 VDD1_5 GND {VDD1_5}
vclk clk GND PULSE(0 1.5 13n 0.1n 0.1n 50n 100n)
Cb5 vout GND 2.4p
R2 GND vout 250k
L20 net2 net3 8.33u
R1 net2 vin 50
Cb1 net1 GND 1.25n
Cb3 net3 net1 16.14f
L22 net1 GND 107p
L24 net1 net4 344n
Cb4 net4 GND 330f
Cb2 net4 net5 10p
x1 net6 net7 net8 net9 net10 net11 net12 net13 VDD3_3 VDD1_5 q3 q2 net5 q1 q0 vout GND net14 ook_receiver
**** begin user architecture code



.param VDD3_3=3.3
.param VDD1_5=1.5
.options rshunt=1G
.param temp=27
.options savecurrents klu reltol=1e-3 abstol=1e-12 vntol=1e-6 gmin=1e-12
.options itl4=500
.options method=gear maxord=2
.options trtol=10
Vcarrier ncar 0 SINE(0 100m 433.92e6)
Venv nenv 0 PULSE(0 1 5.4u 0.6u 0.6u 5.4u 12u)
*Vnoise nnoise 0 DC 0 TRNOISE(223.6n 1p 0 0)
Bvin1 vin 0 V={(V(nenv)*V(ncar) + 1e-12)}
.control
save vin i(vdd3_3) i(vdd1_5) vout q0 q1 q2 q3 x1.ampo
op
print all
write ook_receiver_tb_tran\.raw
set appendwrite
tran 100p 36u 0u 100p uic
*tran 10p 11.6u 11.2u 100p
write ook_receiver_tb_tran\.raw
unset appendwrite
plot i(vdd3_3)
plot i(vdd1_5)
plot v(vout) vin
plot v(vout) q0 q1 q2 q3
plot x1.ampo
.endc




.lib cornerMOSlv.lib mos_tt
.lib cornerMOShv.lib mos_tt
.lib cornerRES.lib res_typ
.lib cornerDIO.lib dio_tt
.lib cornerCAP.lib cap_typ


**** end user architecture code
**.ends

